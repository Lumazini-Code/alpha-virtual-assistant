# AVA — exemplo de configuração (copie para Modules/.env e preencha)
# Permissões recomendadas: chmod 600 Modules/.env

# Chave da API OpenRouter (obrigatória)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token de autenticação interna compartilhado por TODOS os serviços
# (orchestrator:9000, memory:3000, LLM:4003, TTS:3004, vision:4002,
#  onnxManager, mcp_manager:4008, Manager:9001).
# Gerado automaticamente pelo install.sh — ou manualmente com:
#   python3 -m Modules.internal_auth gen
AVA_INTERNAL_TOKEN=troque-por-um-token-aleatorio-forte

# Host de bind dos serviços internos (default: 127.0.0.1)
# NÃO mude para 0.0.0.0 sem garantir autenticação.
AVA_BIND_HOST=127.0.0.1

# Modo de falha quando AVA_INTERNAL_TOKEN está ausente:
#   vazio/0 = fail-open (aceita sem token — modo legado)
#   1       = fail-closed (401 em todas as rotas não-isentas)
AVA_REQUIRE_AUTH=1

# Portas internas dos serviços (defaults)
# ORCHESTRATOR_PORT=9000
# MEMORY_API_PORT=3000
# LLM_PORT=4003
# TTS_PORT=3004
# VISION_PORT=4002
# MCP_MANAGER_PORT=4008
# PROCESS_MANAGER_PORT=9001
