{
  "name": "alpha-ai-tui",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "alpha-ai": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "bun scripts/patch-cfonts.mjs && bun build --compile --minify --target=bun-linux-x64   src/cli.tsx --outfile dist/alpha-ai && bun build --compile --minify --target=bun-windows-x64 src/cli.tsx --outfile dist/alpha-ai.exe",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "execa": "^9.3.0",
    "ink": "^6.0.0",
    "ink-big-text": "^2.0.0",
    "ink-file-picker": "^0.3.4",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.0.0",
    "systeminformation": "^5.22.11"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^19.0.0",
    "react-devtools-core": "^8.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
